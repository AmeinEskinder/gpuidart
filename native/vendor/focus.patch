+    /// Associate an existing accessibility node with the control's editing focus.
+    ///
+    /// Call during that element's prepaint, while its accessibility node exists.
+    /// This registers accessibility focus and Focus actions without registering a
+    /// second keyboard/tab stop. It is useful when an outer presentation frame
+    /// and its inner editor use different focus handles.
+    pub fn track_a11y_focus(&mut self, id: &GlobalElementId, focus: &FocusHandle) {
+        if self.a11y.is_active() {
+            let node_id = id.accesskit_node_id();
+            self.a11y.set_focusable(node_id, focus.id);
+            if focus.is_focused(self) {
+                self.a11y.set_focus(node_id);
+            }
+        }
+    }
