 impl Drop for DirectXRenderer {
     fn drop(&mut self) {
+        let window = self.hwnd.0 as isize;
+        LAST_PRESENTS
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .retain(|(known, _)| *known != window);
